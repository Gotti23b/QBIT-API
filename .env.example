# Copy to .env and set a unique random secret (at least 32 characters).
QBIT_ADMIN_TOKEN=replace-with-a-long-random-secret
PORT=3000
HOST=0.0.0.0
QBIT_DB_PATH=./data/qbit.sqlite

# Comma-separated exact origins. Leave empty during local development only.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
